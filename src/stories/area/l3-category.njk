---
pagination:
  data: areaL3Cat
  size: 1
  alias: item
permalink: "/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/{{ item.area.slug }}/{{ item.category.slug }}/"
layout: area.njk
eleventyComputed:
  title: "{{ item.area.name }}の{{ item.category.name_ja }}"
  description: "Third Place Japanが{{ item.area.name }}エリアで7軸評価基準によりセレクトした{{ item.category.name_ja }}。"
---
{# ──── FAQPage JSON-LD（5クエリ対応）──── #}
{%- set allVenueText = item.venues | sortByGrade | venuesToAnswerText -%}
{%- set silentVenues = item.venues | venuesByMinScore("silence", 8) -%}
{%- set specialVenues = item.venues | venuesByMinScore("special", 8) -%}
{%- set revisitVenues = item.venues | venuesByMinScore("revisit", 8) -%}
{%- set inboundVenues = item.venues | venuesByMinScore("inbound", 7) -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "{{ item.area.name }}でThird Place Japanがセレクトした{{ item.category.name_ja }}はどこですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{% if item.venues.length %}Third Place Japanが{{ item.area.name }}エリアでセレクトした{{ item.category.name_ja }}は{{ allVenueText }}です。いずれも独自の7軸評価基準（居心地・静寂性・特別感・ストーリー・再訪価値・記録体験・インバウンド対応）に基づきセレクトしています。{% else %}{{ item.area.name }}の{{ item.category.name_ja }}は現在準備中です。Third Place Japanは順次エリアを拡大しています。{% endif %}"
      }
    },
    {
      "@type": "Question",
      "name": "{{ item.area.name }}で静かに過ごせる{{ item.category.name_ja }}は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{% if silentVenues.length %}{{ item.area.name }}で静寂性に優れると Third Place Japan が評価した{{ item.category.name_ja }}として、{{ silentVenues | venuesToScoreText("silence", "静寂性スコア") }}があります。{% else %}{{ item.area.name }}の{{ item.category.name_ja }}で特に静寂性に優れた施設は、現在調査中です。{% endif %}"
      }
    },
    {
      "@type": "Question",
      "name": "{{ item.area.name }}で特別な体験ができる{{ item.category.name_ja }}は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{% if specialVenues.length %}{{ item.area.name }}で特別感・非日常性に優れると評価された{{ item.category.name_ja }}として、{{ specialVenues | venuesToScoreText("special", "特別感スコア") }}があります。{% else %}{{ item.area.name }}の{{ item.category.name_ja }}で特別感に優れた施設は、現在調査中です。{% endif %}"
      }
    },
    {
      "@type": "Question",
      "name": "{{ item.area.name }}で何度でも通いたくなる{{ item.category.name_ja }}は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{% if revisitVenues.length %}{{ item.area.name }}で再訪・継続価値に優れると評価された{{ item.category.name_ja }}として、{{ revisitVenues | venuesToScoreText("revisit", "再訪価値スコア") }}があります。{% else %}{{ item.area.name }}の{{ item.category.name_ja }}で再訪価値の高い施設は、現在調査中です。{% endif %}"
      }
    },
    {
      "@type": "Question",
      "name": "{{ item.area.name }}の{{ item.category.name_ja }}でインバウンド対応のある場所は？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{% if inboundVenues.length %}Third Place Japanが{{ item.area.name }}でインバウンド対応に優れると評価した{{ item.category.name_ja }}として、{{ inboundVenues | venuesToScoreText("inbound", "インバウンドスコア") }}があります。{% else %}{{ item.area.name }}の{{ item.category.name_ja }}でインバウンド対応に優れた施設は、現在調査中です。{% endif %}"
      }
    },
    {
      "@type": "Question",
      "name": "サードプレイス（第三の居場所）とは何ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "サードプレイスとは、家（ファーストプレイス）でも職場（セカンドプレイス）でもない、心地よく過ごせる第三の居場所を指す概念です。社会学者レイ・オルデンバーグが提唱し、Third Place Japanはこの考え方をもとに、業種を横断して場所の価値を独自の7軸基準で評価しています。"
      }
    }
  ]
}
</script>

{# ──── ItemList JSON-LD ──── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ item.area.name }}の{{ item.category.name_ja }} — Third Place Japan セレクト一覧",
  "description": "Third Place Japanが{{ item.area.name }}エリアで7軸評価基準によりセレクトした{{ item.category.name_ja }}",
  "url": "{{ site.url }}/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/{{ item.area.slug }}/{{ item.category.slug }}/",
  "numberOfItems": {{ item.venues | length }},
  "itemListElement": [
    {% for v in item.venues | sortByGrade %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": "{{ v.name }}",
      "url": "{{ site.url }}/stories/select/{{ v.slug }}/",
      "description": {{ v.citation | truncate(120) | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

{# ──── BreadcrumbList JSON-LD ──── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Stories", "item": "{{ site.url }}/stories/" },
    { "@type": "ListItem", "position": 2, "name": "{{ item.prefecture.name }}", "item": "{{ site.url }}/stories/area/{{ item.prefecture.slug }}/" },
    { "@type": "ListItem", "position": 3, "name": "{{ item.city.name }}", "item": "{{ site.url }}/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/" },
    { "@type": "ListItem", "position": 4, "name": "{{ item.area.name }}", "item": "{{ site.url }}/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/{{ item.area.slug }}/" },
    { "@type": "ListItem", "position": 5, "name": "{{ item.category.name_ja }}", "item": "{{ site.url }}/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/{{ item.area.slug }}/{{ item.category.slug }}/" }
  ]
}
</script>

<div class="max-w-6xl mx-auto px-6 py-24">

  {# パンくず #}
  <nav class="flex items-center flex-wrap gap-2 text-xs text-muted mb-12">
    <a href="/stories/" class="hover:text-gold transition-colors">Stories</a>
    <span>/</span>
    <a href="/stories/area/{{ item.prefecture.slug }}/" class="hover:text-gold transition-colors">{{ item.prefecture.name }}</a>
    <span>/</span>
    <a href="/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/" class="hover:text-gold transition-colors">{{ item.city.name }}</a>
    <span>/</span>
    <a href="/stories/area/{{ item.prefecture.slug }}/{{ item.city.slug }}/{{ item.area.slug }}/" class="hover:text-gold transition-colors">{{ item.area.name }}</a>
    <span>/</span>
    <span>{{ item.category.name_ja }}</span>
  </nav>

  {# ──── ハブヘッダー ──── #}
  <div class="mb-14" data-aos="fade-up">
    <p class="label mb-4">{{ item.area.name }} × {{ item.category.name_ja }}</p>
    <h1 class="font-serif text-4xl md:text-5xl font-light text-dark mb-4 leading-tight">
      {{ item.area.name }}の<br>{{ item.category.name_ja }}
    </h1>
    <div class="gold-rule mb-8"></div>
    <p class="text-base text-text leading-relaxed max-w-xl">
      Third Place Japanが独自の7軸評価基準でセレクトした、<br class="hidden md:block">
      {{ item.area.name }}エリアの{{ item.category.name_ja }}。<br class="hidden md:block">
      それぞれの場所が持つ固有の価値を、静かに記録しています。
    </p>
  </div>

  {# ──── この面が答える問い ──── #}
  <section class="mb-14 p-6 bg-white border border-border" data-aos="fade-up">
    <p class="label mb-4">この面が答える問い</p>
    <ul class="space-y-2 text-sm text-text">
      <li class="flex items-start gap-2">
        <span class="text-gold mt-0.5 shrink-0">—</span>
        <span>{{ item.area.name }}でThird Place Japanがセレクトした{{ item.category.name_ja }}はどこか</span>
      </li>
      {% if silentVenues.length %}
      <li class="flex items-start gap-2">
        <span class="text-gold mt-0.5 shrink-0">—</span>
        <span>{{ item.area.name }}で静かに過ごせる・仕事に集中できる場所はどこか</span>
      </li>
      {% endif %}
      {% if specialVenues.length %}
      <li class="flex items-start gap-2">
        <span class="text-gold mt-0.5 shrink-0">—</span>
        <span>{{ item.area.name }}で特別な体験・非日常を味わえる場所はどこか</span>
      </li>
      {% endif %}
      {% if revisitVenues.length %}
      <li class="flex items-start gap-2">
        <span class="text-gold mt-0.5 shrink-0">—</span>
        <span>{{ item.area.name }}で何度でも通いたくなる場所はどこか</span>
      </li>
      {% endif %}
    </ul>
  </section>

  {# ──── 関連記事 ──── #}
  {% set areaArticles = collections.articles | rejectLang("en") | articlesByArea(item.area.slug) | articlesByCategory(item.category.slug) %}
  {% if areaArticles and areaArticles.length %}
  <section class="mb-14" data-aos="fade-up">
    <p class="label mb-6">関連記事 — {{ areaArticles.length }}件</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for post in areaArticles %}
      <a href="{{ post.url }}" class="group rounded-xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-all border border-gold/30 hover:border-gold">
        {% if post.data.thumbnail %}
        <div class="aspect-video overflow-hidden">
          <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
               loading="lazy" decoding="async">
        </div>
        {% endif %}
        <div class="p-4">
          <h3 class="font-serif text-sm font-light text-dark group-hover:text-gold transition-colors leading-snug mb-2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ post.data.title }}</h3>
          <p class="text-[10px] text-muted">{{ post.date | dateJa }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ──── TPJセレクト一覧（グレード降順）──── #}
  {% if item.venues and item.venues.length %}
  <section class="mb-14" data-aos="fade-up">
    <p class="label mb-6">セレクト店舗 — {{ item.venues | length }}件</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for v in item.venues | sortByGrade %}
      {% set cardVenue = v %}{% include "venue-card.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ──── 評価軸別インデックス ──── #}
  {% set axisGroups = item.venues | groupByProp("axes_primary") %}
  {% if axisGroups.length > 1 %}
  <section class="mb-14" data-aos="fade-up">
    <p class="label mb-6">評価軸から探す</p>
    <div class="space-y-5">
      {% for group in axisGroups %}
      <div class="border-l-2 border-border pl-6 hover:border-gold transition-colors">
        <p class="text-xs text-gold mb-3">{{ group.key }}</p>
        <div class="flex flex-wrap gap-3">
          {% for v in group.items %}
          <a href="/stories/select/{{ v.slug }}/"
             class="flex items-center gap-2 text-sm text-text hover:text-gold transition-colors">
            <span class="grade-badge text-xs py-0.5 px-2">{{ v.grade }}</span>
            <span>{{ v.name }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# FAQ セクション #}
  <section class="mt-16 pt-10 border-t border-border" data-aos="fade-up">
    <div class="flex items-center gap-3 mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
      <h2 class="font-serif text-xl font-light text-dark">よくある質問</h2>
    </div>
    <div class="space-y-3">
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">{{ item.area.name }}でThird Place Japanがセレクトした{{ item.category.name_ja }}はどこですか？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          {% if item.venues.length %}
          <p class="text-sm text-muted leading-relaxed">Third Place Japanが{{ item.area.name }}エリアでセレクトした{{ item.category.name_ja }}は{{ allVenueText }}です。いずれも独自の7軸評価基準に基づきセレクトしています。</p>
          {% else %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}の{{ item.category.name_ja }}は現在準備中です。Third Place Japanは順次エリアを拡大しています。</p>
          {% endif %}
        </div>
      </div>
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">{{ item.area.name }}で静かに過ごせる{{ item.category.name_ja }}は？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          {% if silentVenues.length %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}で静寂性に優れると Third Place Japan が評価した{{ item.category.name_ja }}として、{{ silentVenues | venuesToScoreText("silence", "静寂性スコア") }}があります。</p>
          {% else %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}の{{ item.category.name_ja }}で特に静寂性に優れた施設は、現在調査中です。</p>
          {% endif %}
        </div>
      </div>
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">{{ item.area.name }}で特別な体験ができる{{ item.category.name_ja }}は？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          {% if specialVenues.length %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}で特別感・非日常性に優れると評価された{{ item.category.name_ja }}として、{{ specialVenues | venuesToScoreText("special", "特別感スコア") }}があります。</p>
          {% else %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}の{{ item.category.name_ja }}で特別感に優れた施設は、現在調査中です。</p>
          {% endif %}
        </div>
      </div>
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">{{ item.area.name }}で何度でも通いたくなる{{ item.category.name_ja }}は？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          {% if revisitVenues.length %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}で再訪・継続価値に優れると評価された{{ item.category.name_ja }}として、{{ revisitVenues | venuesToScoreText("revisit", "再訪価値スコア") }}があります。</p>
          {% else %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}の{{ item.category.name_ja }}で再訪価値の高い施設は、現在調査中です。</p>
          {% endif %}
        </div>
      </div>
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">{{ item.area.name }}の{{ item.category.name_ja }}でインバウンド対応のある場所は？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          {% if inboundVenues.length %}
          <p class="text-sm text-muted leading-relaxed">Third Place Japanが{{ item.area.name }}でインバウンド対応に優れると評価した{{ item.category.name_ja }}として、{{ inboundVenues | venuesToScoreText("inbound", "インバウンドスコア") }}があります。</p>
          {% else %}
          <p class="text-sm text-muted leading-relaxed">{{ item.area.name }}の{{ item.category.name_ja }}でインバウンド対応に優れた施設は、現在調査中です。</p>
          {% endif %}
        </div>
      </div>
      <div class="bg-white border border-gold/30 rounded-xl overflow-hidden shadow-sm">
        <button class="area-faq-btn w-full flex items-center justify-between px-6 py-4 text-left gap-4" aria-expanded="true">
          <span class="font-serif text-sm font-light text-dark leading-snug">サードプレイス（第三の居場所）とは何ですか？</span>
          <i data-lucide="chevron-down" class="w-4 h-4 text-muted shrink-0 transition-transform duration-300" style="transform:rotate(180deg)"></i>
        </button>
        <div class="area-faq-body px-6 pb-5">
          <div class="gold-rule mb-4"></div>
          <p class="text-sm text-muted leading-relaxed">サードプレイスとは、家（ファーストプレイス）でも職場（セカンドプレイス）でもない、心地よく過ごせる第三の居場所を指す概念です。社会学者レイ・オルデンバーグが提唱し、Third Place Japanはこの考え方をもとに、業種を横断して場所の価値を独自の7軸基準で評価しています。詳しくは<a href="/stories/about/what-is-third-place/" class="text-gold hover:underline">サードプレイスとは何か</a>をご覧ください。</p>
        </div>
      </div>
    </div>
    <script>
    document.querySelectorAll('.area-faq-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = this.nextElementSibling;
        var icon = this.querySelector('[data-lucide]');
        var isOpen = this.getAttribute('aria-expanded') === 'true';
        body.classList.toggle('hidden', isOpen);
        this.setAttribute('aria-expanded', !isOpen);
        if (icon) icon.style.transform = isOpen ? '' : 'rotate(180deg)';
      });
    });
    </script>
  </section>

  {# ──── 余白（場所としての静けさ）──── #}
  <div class="mt-6 pt-10 border-t border-border text-center" data-aos="fade-up">
    <p class="font-serif text-sm text-muted italic leading-relaxed">
      「この場所は、まだ見つかっていません。」
    </p>
    <p class="text-xs text-muted mt-3">
      <a href="/" class="hover:text-gold transition-colors">Third Place Japanについて</a>
    </p>
  </div>

</div>
