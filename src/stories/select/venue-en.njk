---
pagination:
  data: venuesEn
  size: 1
  alias: venue
  addAllPagesToCollections: true
permalink: "/en/stories/select/{{ venue.slug }}/"
layout: venue-en.njk
lang: "en"
eleventyComputed:
  title: "{% if venue.title_override_en %}{{ venue.title_override_en | safe }}{% else %}{{ venue.name_en | safe }}{% endif %}"
  title_suffix: "Third Place Japan"
  description: "{{ venue.citation_en | safe }}"
  hreflang_ja: "/stories/select/{{ venue.slug }}/"
  hreflang_en: "/en/stories/select/{{ venue.slug }}/"
  og_image: "{% set defaultVenueImg = '/assets/images/main/japan-cafe-interior-hero.webp' %}{% if venue.image and venue.image != defaultVenueImg %}{{ venue.image | safe }}{% else %}{% set venueCat = categories | findCategoryBySlug(venue.category_slug) %}{% if venueCat and venueCat.image %}{{ venueCat.image | safe }}{% else %}{{ defaultVenueImg | safe }}{% endif %}{% endif %}"
---
