---
layout: stories.njk
title: "Discover Japan's Third Places"
description: "Third Place Japan Stories in English — guides to finding your third place in Japan, evaluated by TPJ's 7-axis certification framework."
canonical: "/en/stories/"
lang: "en"
hreflang_ja: "/stories/"
hreflang_en: "/en/stories/"
---

<div class="max-w-4xl mx-auto px-6 py-20">

  <div class="mb-14" data-aos="fade-up">
    <p class="label mb-4">English</p>
    <h1 class="font-serif text-4xl font-light text-dark mb-4">Third Place Japan — English Stories</h1>
    <div class="gold-rule mb-6"></div>
    <p class="text-sm text-muted leading-relaxed max-w-xl">
      Third Place Japan evaluates spaces across Japan using a seven-axis framework.
      These English articles introduce the concept of the third place in a Japanese context.
    </p>
  </div>

  {% set enArticles = collections.articles | selectLang("en") %}
  {% set articleVisibleCount = 21 %}

  {# Latest 2 articles: large featured cards #}
  {% if enArticles.length %}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4" data-aos="fade-up">
    {% for post in enArticles %}
    {% if loop.index <= 2 %}
    {% set postCat = categories | findCategoryBySlug(post.data.category_slug) %}
    <a href="{{ post.url }}" class="group rounded-xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-all border border-gold">
      {% if post.data.thumbnail %}
      <div class="aspect-[8/3] overflow-hidden">
        <img src="{{ post.data.thumbnail }}" alt="{{ post.data.title }}"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
             loading="lazy" decoding="async">
      </div>
      {% else %}
      <div class="aspect-[8/3] bg-ivory"></div>
      {% endif %}
      <div class="p-4">
        <div class="flex items-center flex-wrap gap-2 mb-2">
          {% if postCat %}
          <span class="inline-block text-xs text-gold border border-gold rounded-full px-2.5 py-0.5">{{ postCat.name_en }}</span>
          {% elif post.data.category_slug == "about" %}
          <span class="inline-block text-xs text-gold border border-gold rounded-full px-2.5 py-0.5">Concept</span>
          {% endif %}
          {% if post.data.area_name %}
          <span class="text-xs text-muted font-medium">{{ post.data.area_name }}</span>
          {% endif %}
          <span class="new-badge hidden text-gold border border-gold text-[10px] font-medium tracking-widest px-2.5 py-0.5 rounded-full" data-publish="{{ post.date | dateISO }}">NEW</span>
        </div>
        <h2 class="font-serif text-sm font-light text-dark group-hover:text-gold transition-colors leading-snug mb-2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ post.data.title }}</h2>
        {% if post.data.description %}
        <p class="text-xs text-muted leading-relaxed" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{{ post.data.description }}</p>
        {% endif %}
        <p class="text-[10px] text-muted mt-2">{{ post.date | dateEn }}</p>
      </div>
    </a>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <div class="space-y-6" data-aos="fade-up" id="en-article-list">
    {% for post in enArticles %}
    {% if loop.index > 2 %}
    {% set postCat = categories | findCategoryBySlug(post.data.category_slug) %}
    <a href="{{ post.url }}"
       class="group flex items-stretch bg-white rounded-2xl overflow-hidden border border-border hover:border-gold shadow-sm hover:shadow-md transition-all{% if loop.index > articleVisibleCount %} article-extra hidden{% endif %}">
      <div class="shrink-0 w-40 md:w-52 overflow-hidden">
        <img src="{{ post.data.thumbnail }}"
             alt="{{ post.data.title }}"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
             loading="lazy" decoding="async">
      </div>
      <div class="p-5 md:p-6 flex flex-col justify-center min-w-0">
        <span class="inline-block text-xs text-gold border border-gold rounded-full px-3 py-0.5 mb-3 w-fit">
          {% if postCat %}{{ postCat.name_en }}{% elif post.data.category_slug == "about" %}Concept{% else %}Journal{% endif %}
        </span>
        <h2 class="font-serif text-base md:text-lg font-light text-dark group-hover:text-gold transition-colors leading-snug mb-2"
            style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
          {{ post.data.title }}
        </h2>
        <p class="text-sm text-muted leading-relaxed"
           style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
          {{ post.data.description }}
        </p>
      </div>
    </a>
    {% endif %}
    {% endfor %}
  </div>

  {% if enArticles.length > articleVisibleCount %}
  <div class="text-center mt-8">
    <button type="button" id="en-article-more-btn"
            class="inline-flex items-center gap-2 bg-white hover:bg-ivory border border-gold text-gold rounded-full px-7 py-2.5 text-sm transition-colors shadow-sm">
      Show more ({{ enArticles.length - articleVisibleCount }} remaining)
    </button>
  </div>
  <script>
  (function() {
    var btn = document.getElementById('en-article-more-btn');
    if (!btn) return;
    btn.addEventListener('click', function() {
      document.querySelectorAll('#en-article-list .article-extra').forEach(function(el) {
        el.classList.remove('hidden');
      });
      btn.remove();
    });
  })();
  </script>
  {% endif %}

  <script>
  (function() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    document.querySelectorAll('.new-badge').forEach(function(badge) {
      const pub = new Date(badge.dataset.publish);
      pub.setHours(0, 0, 0, 0);
      const diff = (today - pub) / (1000 * 60 * 60 * 24);
      if (diff <= 3) badge.classList.remove('hidden');
    });
  })();
  </script>

  <div class="mt-14 pt-10 border-t border-border text-center" data-aos="fade-up">
    <a href="/stories/" class="text-sm text-muted hover:text-gold transition-colors">← 日本語版 TPJ Stories</a>
  </div>

</div>
