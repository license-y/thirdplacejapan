{# venue-card.njk — Usage: {% set cardVenue = venue %}{% include "venue-card.njk" %} #}
<a href="/stories/select/{{ cardVenue.slug }}/" class="no-underline! venue-card block p-4 md:p-6 bg-white border border-border hover:border-gold hover:bg-ivory focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/40 transition-colors group">
  <div class="flex items-start justify-between gap-2 mb-3">
    <span class="label text-xs">{{ cardVenue.category }}</span>
    {% if cardVenue.grade_slug == "select" %}
    <span class="inline-flex items-center gap-1 text-[10px] text-muted border border-border rounded-full px-2 py-0.5 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      TPJセレクト
    </span>
    {% else %}
    <span class="text-[10px] font-medium tracking-wider text-gold border border-gold rounded-full px-2 py-0.5 shrink-0">{{ cardVenue.grade }}</span>
    {% endif %}
  </div>
  <h3 class="font-serif text-lg font-light text-dark mb-1.5 group-hover:text-gold transition-colors">
    {{ cardVenue.name }}
  </h3>
  <p class="text-xs text-muted mb-3">
    {{ cardVenue.area_primary.prefecture }} {{ cardVenue.area_primary.area }}
  </p>
  <p class="text-sm text-text leading-relaxed line-clamp-2 md:line-clamp-3">{{ cardVenue.citation }}</p>
  <div class="mt-3 flex flex-wrap gap-1.5 md:gap-2">
    <span class="text-xs text-gold border border-gold px-3 py-0.5 rounded-full">{{ cardVenue.axes_primary }}</span>
    {% for ax in cardVenue.axes_secondary %}
    <span class="text-xs text-muted border border-border px-3 py-0.5 rounded-full">{{ ax }}</span>
    {% endfor %}
  </div>
</a>
